FROM ollama/ollama

# Instalar curl y dos2unix para diagnostico y correccion de line endings de Windows
RUN apt-get update && apt-get install -y --no-install-recommends curl dos2unix \
    && rm -rf /var/lib/apt/lists/*

EXPOSE 11434

# Copiar el script y convertir CRLF -> LF (necesario cuando se edita en Windows)
COPY ollama-entrypoint.sh /entrypoint.sh
RUN dos2unix /entrypoint.sh && chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
