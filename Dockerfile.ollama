FROM ollama/ollama

EXPOSE 11434

ENTRYPOINT ["/bin/bash", "-c", "\
  ollama serve & \
  until curl -sf http://localhost:11434/api/tags > /dev/null 2>&1; do sleep 1; done && \
  echo 'Servidor listo. Descargando modelo llama3.2:3b...' && \
  ollama pull llama3.2:3b && \
  echo 'Modelo listo.' && \
  wait"]
