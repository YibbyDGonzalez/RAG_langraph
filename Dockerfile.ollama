FROM ollama/ollama

# Pre-download llama3.2:3b at build time so the image is fully portable
RUN /bin/bash -c "\
    ollama serve & \
    until curl -sf http://localhost:11434/api/tags > /dev/null 2>&1; do sleep 1; done && \
    ollama pull llama3.2:3b && \
    pkill ollama"

EXPOSE 11434

CMD ["serve"]
